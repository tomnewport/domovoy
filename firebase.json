{
  "hosting": [
    {
      "target": "gcp-prod",
      "public": "domovoy_app/dist",
      "ignore": ["firebase.json", "**/.*"],
      "rewrites": [
        { "source": "/api", "run": { "serviceId": "domovoy-prod", "region": "europe-west2" } },
        { "source": "/api/**", "run": { "serviceId": "domovoy-prod", "region": "europe-west2" } },
        { "source": "/api-static/**", "run": { "serviceId": "domovoy-prod", "region": "europe-west2" } },
        { "source": "/krimba", "run": { "serviceId": "domovoy-prod", "region": "europe-west2" } },
        { "source": "/krimba/**", "run": { "serviceId": "domovoy-prod", "region": "europe-west2" } },
        { "source": "**", "destination": "/index.html" }
      ],
      "headers": [
        { "source": "**", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
        { "source": "/assets/**", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
        { "source": "/api", "headers": [{ "key": "Cache-Control", "value": "max-age=0, no-cache, no-store, must-revalidate, private" }] },
        { "source": "/api/**", "headers": [{ "key": "Cache-Control", "value": "max-age=0, no-cache, no-store, must-revalidate, private" }] },
        { "source": "/krimba", "headers": [{ "key": "Cache-Control", "value": "max-age=0, no-cache, no-store, must-revalidate, private" }] },
        { "source": "/krimba/**", "headers": [{ "key": "Cache-Control", "value": "max-age=0, no-cache, no-store, must-revalidate, private" }] },
        { "source": "/api-static/**", "headers": [{ "key": "Cache-Control", "value": "public, max-age=60" }] },
        { "regex": "^/api-static/.+\\.[0-9a-f]{12}\\.[A-Za-z0-9]+$", "headers": [{ "key": "Cache-Control", "value": "public, max-age=315360000, immutable" }] }
      ]
    },
    {
      "target": "gcp-dev",
      "public": "domovoy_app/dist",
      "ignore": ["firebase.json", "**/.*"],
      "rewrites": [
        { "source": "/api", "run": { "serviceId": "domovoy-dev", "region": "europe-west2" } },
        { "source": "/api/**", "run": { "serviceId": "domovoy-dev", "region": "europe-west2" } },
        { "source": "/api-static/**", "run": { "serviceId": "domovoy-dev", "region": "europe-west2" } },
        { "source": "/krimba", "run": { "serviceId": "domovoy-dev", "region": "europe-west2" } },
        { "source": "/krimba/**", "run": { "serviceId": "domovoy-dev", "region": "europe-west2" } },
        { "source": "**", "destination": "/index.html" }
      ],
      "headers": [
        { "source": "**", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
        { "source": "/assets/**", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
        { "source": "/api", "headers": [{ "key": "Cache-Control", "value": "max-age=0, no-cache, no-store, must-revalidate, private" }] },
        { "source": "/api/**", "headers": [{ "key": "Cache-Control", "value": "max-age=0, no-cache, no-store, must-revalidate, private" }] },
        { "source": "/krimba", "headers": [{ "key": "Cache-Control", "value": "max-age=0, no-cache, no-store, must-revalidate, private" }] },
        { "source": "/krimba/**", "headers": [{ "key": "Cache-Control", "value": "max-age=0, no-cache, no-store, must-revalidate, private" }] },
        { "source": "/api-static/**", "headers": [{ "key": "Cache-Control", "value": "public, max-age=60" }] },
        { "regex": "^/api-static/.+\\.[0-9a-f]{12}\\.[A-Za-z0-9]+$", "headers": [{ "key": "Cache-Control", "value": "public, max-age=315360000, immutable" }] }
      ]
    }
  ]
}
