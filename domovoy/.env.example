# Local development settings. Copy to domovoy/.env and adjust:
#   cp domovoy/.env.example domovoy/.env
# Every variable is described in the README's "Configuration" table. Lists are
# JSON. Deployments get their settings from Secret Manager and GitHub
# variables (docs/DEPLOY_GCP.md), never from a committed file.

domovoy_server_secret_key=change-me-to-a-long-random-string
domovoy_django_debug=true
domovoy_allowed_hosts=["localhost","127.0.0.1"]
# The Vite dev server calls the API on :8000 from another origin.
domovoy_allowed_cors_origins=["http://localhost:5173"]
domovoy_frontend_root=http://localhost:5173/

# Required, but email isn't sent yet: utils/email.py prints login links to the
# console instead.
domovoy_smtp_server=localhost
domovoy_smtp_port=25
domovoy_smtp_username=dev
domovoy_smtp_password=dev

# Unset uses SQLite at domovoy/data/db.sqlite3. For Postgres:
# domovoy_database_url=postgresql://user:pass@localhost:5432/domovoy
